#!/bin/sh
set -e

case "$1" in
    configure)
        occitux-config || echo "occitux : réglages incomplets, ils seront refaits au prochain démarrage" >&2
        deb-systemd-helper enable occitux-premier-demarrage.service >/dev/null || true
        ;;
    triggered)
        # Un paquet de PrimTux ou de Mint vient de remplacer des fichiers habillés.
        occitux-config --declenche || true
        ;;
esac
