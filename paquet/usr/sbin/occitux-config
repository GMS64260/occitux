#!/bin/bash
# occitux-config : applique /etc/occitux/occitux.conf au système.
#
# Lancé par le paquet à l'installation, puis une fois au premier démarrage
# (l'installateur réécrit la langue et le clavier après la copie du système),
# puis à la main après chaque modification des réglages.
#
#   sudo occitux-config                     applique les réglages
#   occitux-config --premier-demarrage      utilisé par le service systemd
set -euo pipefail

CONF=/etc/occitux/occitux.conf
ETAT=/var/lib/occitux
APT_CONF=/etc/apt/apt.conf.d

LANGUE=oc
CLAVIER=oci
MISES_A_JOUR_AUTO=oui
# shellcheck source=/dev/null
[ -r "$CONF" ] && . "$CONF"

if [ "$(id -u)" -ne 0 ]; then
    echo "occitux-config : à lancer avec sudo" >&2
    exit 1
fi

# Remplace KEY=... dans un fichier, ou l'ajoute s'il n'y est pas.
fixer() {
    local fichier=$1 cle=$2 valeur=$3
    touch "$fichier"
    if grep -q "^${cle}=" "$fichier"; then
        sed -i "s|^${cle}=.*|${cle}=${valeur}|" "$fichier"
    else
        echo "${cle}=${valeur}" >> "$fichier"
    fi
}

appliquer_langue() {
    local lang language
    # bearnes : les catalogues béarnais d'Occitux (/usr/share/locale/oc@gascon,
    # voir appliquer_catalogues) passent d'abord ; ce qu'ils ne traduisent pas
    # retombe sur l'occitan, puis sur le français.
    case "$LANGUE" in
        bearnes) lang=oc_FR.UTF-8; language=oc_FR@gascon:oc:fr ;;
        oc)      lang=oc_FR.UTF-8; language=oc:fr ;;
        fr)      lang=fr_FR.UTF-8; language=fr ;;
        *)       echo "occitux-config : LANGUE=$LANGUE inconnue (bearnes, oc ou fr)" >&2; return 1 ;;
    esac

    locale-gen "$lang" fr_FR.UTF-8 >/dev/null
    # LANGUAGE=oc:fr : un logiciel non traduit en occitan s'affiche en
    # français, et non en anglais.
    update-locale LANG="$lang" LANGUAGE="$language"

    # La langue choisie par compte (outil « Langues » de Mint, installateur)
    # passe avant celle du système : on l'aligne.
    local compte
    for compte in /var/lib/AccountsService/users/*; do
        [ -f "$compte" ] || continue
        if grep -q '^Language=' "$compte"; then
            sed -i "s|^Language=.*|Language=${lang}|" "$compte"
        fi
    done
    echo "langue : $lang (repli : $language)"
}

# Les logiciels qui ne connaissent pas l'occitan et ne savent pas se replier
# sur le français : on les règle en français.
#
# GCompris, réglé sur « system », cherche une traduction oc_FR, ne la trouve
# pas et s'affiche en anglais, sans voix. PrimTux le livre avec seulement
# l'anglais et le français. Ses réglages vivent dans le dossier de chaque
# élève et dans le modèle /etc/skel-<élève> dont PrimTux le recrée.
GCOMPRIS_TRADUCTIONS=/opt/gcompris-qt/usr/share/gcompris-qt/translations
FIREFOX_PREFS=/usr/lib/firefox/defaults/pref
appliquer_applications() {
    local conf avant apres
    if [ "$LANGUE" = fr ] || compgen -G "$GCOMPRIS_TRADUCTIONS/gcompris_oc*.qm" >/dev/null; then
        avant=fr_FR.UTF-8; apres=system
    else
        avant=system; apres=fr_FR.UTF-8
    fi
    for conf in /home/*/.config/gcompris/gcompris-qt.conf /etc/skel*/.config/gcompris/gcompris-qt.conf; do
        [ -f "$conf" ] || continue
        sed -i "s|^locale=${avant}\$|locale=${apres}|" "$conf"
    done
    echo "GCompris : ${apres/system/langue du système}"

    # Firefox en occitan demande aux sites « occitan, puis anglais » : un site
    # sans occitan s'afficherait en anglais. On intercale le français.
    if [ -d "$FIREFOX_PREFS" ]; then
        if [ "$LANGUE" = fr ]; then
            rm -f "$FIREFOX_PREFS/occitux.js"
        else
            cat > "$FIREFOX_PREFS/occitux.js" <<'EOF'
// Généré par occitux-config : modifier /etc/occitux/occitux.conf à la place.
pref("intl.accept_languages", "oc, fr-FR, fr, en-US, en");
EOF
            echo "Firefox : sites en occitan, puis en français"
        fi
    fi
}

appliquer_clavier() {
    local variante
    case "$CLAVIER" in
        oci)    variante=oci ;;
        azerty) variante= ;;
        *)      echo "occitux-config : CLAVIER=$CLAVIER inconnu (oci ou azerty)" >&2; return 1 ;;
    esac
    fixer /etc/default/keyboard XKBLAYOUT '"fr"'
    fixer /etc/default/keyboard XKBVARIANT "\"${variante}\""
    echo "clavier : fr${variante:+($variante)}"
}

appliquer_mises_a_jour() {
    local actif ubuntu mint
    case "$MISES_A_JOUR_AUTO" in
        oui) actif=1 ;;
        non) actif=0 ;;
        *)   echo "occitux-config : MISES_A_JOUR_AUTO=$MISES_A_JOUR_AUTO inconnu (oui ou non)" >&2; return 1 ;;
    esac

    # shellcheck source=/dev/null
    . /etc/os-release
    ubuntu=${UBUNTU_CODENAME:-$VERSION_CODENAME}
    mint=
    [ "$VERSION_CODENAME" != "$ubuntu" ] && mint=$VERSION_CODENAME

    # Sur Mint, ${distro_codename} vaut le nom de code Mint (zena) : les règles
    # Ubuntu fournies par défaut ne désignent alors aucun dépôt. On les nomme
    # en dur. Firefox vient du dépôt Mint, d'où la seconde ligne.
    {
        echo "// Généré par occitux-config : modifier /etc/occitux/occitux.conf à la place."
        echo "Unattended-Upgrade::Origins-Pattern {"
        echo "        \"origin=Ubuntu,archive=${ubuntu}-security\";"
        [ -n "$mint" ] && echo "        \"origin=linuxmint,archive=${mint}\";"
        echo "};"
    } > "$APT_CONF/51occitux-unattended-upgrades"
    cat > "$APT_CONF/52occitux-periodic" <<EOF
// Généré par occitux-config : modifier /etc/occitux/occitux.conf à la place.
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Unattended-Upgrade "${actif}";
EOF
    echo "mises à jour automatiques : $MISES_A_JOUR_AUTO (Ubuntu ${ubuntu}-security${mint:+, Mint $mint})"
}

# Le paquet livre ses catalogues béarnais hors de /usr/share/locale, où dpkg
# les écarterait (localepurge de PrimTux) ; un lien les y rend visibles.
CATALOGUES=/usr/share/occitux/locale/oc@gascon
appliquer_catalogues() {
    local lien=/usr/share/locale/oc@gascon
    [ -d "$CATALOGUES" ] || return 0
    if [ -L "$lien" ] || [ ! -e "$lien" ]; then
        ln -sfn "$CATALOGUES" "$lien"
    fi
}

appliquer_catalogues
appliquer_langue
appliquer_applications
appliquer_clavier
appliquer_mises_a_jour

if [ "${1:-}" = --premier-demarrage ]; then
    mkdir -p "$ETAT"
    touch "$ETAT/premier-demarrage-fait"
else
    echo "Redémarrer le PC pour que tout soit pris en compte."
fi
